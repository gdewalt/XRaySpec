# Runtime
XRAY_ENVIRONMENT=production
XRAY_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Supabase Auth. The browser uses the public publishable/anon key. The API reads
# the project's JWKS automatically for current asymmetric access tokens.
XRAY_SUPABASE_PROJECT_URL=https://PROJECT_REF.supabase.co
XRAY_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
# Only legacy HS256 projects need the shared JWT secret:
# XRAY_SUPABASE_JWT_SECRET=legacy-shared-secret

# Supabase Storage server credential. Never expose this value to browser code.
XRAY_SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME
XRAY_STORAGE_BACKEND=supabase
XRAY_STORAGE_BUCKET=xray-sources

# Pydantic parses list-valued settings from JSON.
XRAY_ALLOWED_EMAILS=["owner@example.com"]

# Resource and policy defaults
XRAY_MAX_UPLOAD_BYTES=104857600
XRAY_MAX_IMPORT_BYTES=10485760
XRAY_MAX_CONCURRENT_EXTRACTIONS=1
XRAY_DEFAULT_RETENTION_DAYS=90
XRAY_ENRICHMENT_ENABLED=false
XRAY_RATE_LIMIT_PER_MINUTE=120
XRAY_TRUST_FORWARDED_FOR=true

# Set automatically by scripts/replit-run.sh.
# XRAY_FRONTEND_DIST_DIR=/absolute/path/to/frontend/dist

