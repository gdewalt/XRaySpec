# Copy to .env and fill in. Never commit .env (DESIGN.md §17.5).

XRAY_ENVIRONMENT=development

# Supabase managed Postgres (FastAPI is the only DB client; no RLS/PostgREST).
XRAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xray

# Supabase Auth — JWT verification (DESIGN.md §17.1).
XRAY_SUPABASE_JWT_SECRET=
XRAY_SUPABASE_PROJECT_URL=

# Object storage (Supabase Storage or external S3-compatible; §23 #1 open).
XRAY_STORAGE_BUCKET=xray-sources

# Access control: comma/JSON list of permitted user emails (single-tenant, §3.1).
XRAY_ALLOWED_EMAILS=[]

# Global concurrency cap (§17.6) and instance policy defaults.
XRAY_MAX_CONCURRENT_EXTRACTIONS=2
XRAY_ENRICHMENT_ENABLED=true
XRAY_DEFAULT_RETENTION_DAYS=90
